{
  "name": "pingbot",
  "version": "1.0.0",
  "description": "A multi-purpose Discord Bot written in TypeScript",
  "repository": {
    "type": "git",
    "url": "https://github.com/KrammyGod/pingbot"
  },
  "bugs": {
    "url": "https://github.com/KrammyGod/pingbot/issues"
  },
  "homepage": "https://github.com/KrammyGod/pingbot#readme",
  "keywords": [],
  "author": {
    "name": "KrammyGod",
    "url": "https://github.com/KrammyGod"
  },
  "publisher": "KrammyGod",
  "license": "MIT",
  "main": "dist/index",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "collect:hi3": "env-cmd --environments=hi3 node --env-file-if-exists=.env --enable-source-maps dist/collector/collect",
    "collect:hsr": "env-cmd --environments=hsr node --env-file-if-exists=.env --enable-source-maps dist/collector/collect",
    "collect:gi": "env-cmd --environments=gi node --env-file-if-exists=.env --enable-source-maps dist/collector/collect",
    "collect:ef": "env-cmd --environments=ef node --env-file-if-exists=.env --enable-source-maps dist/collector/collect",
    "reset": "node --env-file-if-exists=.env --enable-source-maps dist/modules/reset_db",
    "cookie": "node --enable-source-maps dist/modules/hoyolab",
    "build:scripts": "tsc -p scripts",
    "cleanup:scripts": "rimraf scripts/download_waifus_txt.js scripts/upload_waifus_txt.js scripts/kubectl_helper.js",
    "predownload": "npm run build:scripts",
    "download": "node --env-file-if-exists=.env scripts/download_waifus_txt.js || exit 0",
    "postdownload": "npm run cleanup:scripts",
    "preupload": "npm run build:scripts",
    "upload": "run-script-os",
    "upload:win32": "node --env-file-if-exists=.env scripts\\upload_waifus_txt.js && type NUL > scripts\\success & npm run cleanup:scripts",
    "upload:nix": "node --env-file-if-exists=.env scripts/upload_waifus_txt.js && touch scripts/success ; npm run cleanup:scripts",
    "postupload:win32": "if exist scripts\\success del scripts\\success && npm run download",
    "postupload:nix": "[ -f scripts/success ] && rm scripts/success && npm run download",
    "dev": "run-script-os",
    "dev:win32": "concurrently -rk \"tsc -w\" \"tsc-alias -w\" \"timeout 4 > NUL && nodemon --env-file-if-exists=.env --enable-source-maps .\"",
    "dev:nix": "concurrently -rk \"tsc -w\" \"tsc-alias -w\" \"sleep ${SLEEP_DUR:-4} ; nodemon --env-file-if-exists=.env --enable-source-maps .\"",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "prebuild": "rimraf ./dist",
    "build": "tsc --build && tsc-alias",
    "deploy": "node --enable-source-maps dist/deployment/deploy_commands.js",
    "start": "node --env-file-if-exists=.env --enable-source-maps ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/glob": "^9.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/pg-copy-streams": "^1.2.5",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "run-script-os": "^1.1.6",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1111.0",
    "@discordjs/voice": "^0.19.2",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.1",
    "cookie": "^2.0.1",
    "discord.js": "^14.27.0",
    "env-cmd": "^11.0.0",
    "ffmpeg-static": "^5.3.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "pixiv.ts": "github:KrammyGod/pixiv.ts",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0",
    "youtube-dl-exec": "^3.1.12"
  }
}
