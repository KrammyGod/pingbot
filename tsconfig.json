{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "outDir": "dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "rootDir": "src",
    "strict": true,
    // @discordjs/voice uses CommonJS
    "esModuleInterop": true,
    "paths": {
      "@files/*": [
        "./files/*"
      ],
      "@classes/*": [
        "./src/classes/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@typings/*": [
        "./src/typings/*"
      ],
      "@config": [
        "./src/classes/config.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
