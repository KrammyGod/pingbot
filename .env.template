# All must be defined:
PREFIX=
ADMIN=
TOKEN=
CLIENT_ID=

# Url for uploading to AWS CloudFront
ORIGIN_URL=
# Support server
GUILD=
# For scraper when scraping from pixiv
PIXIV_REFRESH_TOKEN=
# The twitter scraper server address (twitter-scraper project)
SCRAPER_HOST=
# Error logs
LOGID=
# Submission logs
SUBMIT_ID=
# Confirmed submission logs
NEW_CHAR_ID=
# Saucenao API key in base64
SAUCENAO=

# Postgres connection, read implicitly by node-postgres.
# In Kubernetes these come from the postgres ConfigMap and Secret instead.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Port the bot's message server listens on. Optional, defaults to 5000.
PORT=

# Base url the collector uses to reach the bot's message server
# Optional, defaults to http://localhost:5000
# In Kubernetes, set to http://pingbot:5000
BOT_URL=

# Set to "prod" to enable welcome messages and emoji replacement.
# Any other value (or unset) keeps both off, which is what you want locally.
BOT_ENV=

# Optional. Path to a yt-dlp binary, overriding the copy youtube-dl-exec ships.
# Containers set this to a pip-installed, version-pinned yt-dlp so the extractor
# can be updated without waiting on a youtube-dl-exec release.
YTDLP_PATH=

# Optional. Path to a Netscape format cookies file for a signed in YouTube account.
# Only age gated videos need it; without it they stay unplayable. Containers mount
# it from a PersistentVolume at /data/youtube/cookies.txt, seeded once from a Secret.
# Export one with any Netscape-format cookie exporter while signed in to YouTube.
YT_COOKIES_PATH=

# Toggle for no logs
TESTING=

# Toggle for special events
EVENTS=
